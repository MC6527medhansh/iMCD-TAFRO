# ============================================================
# iMCD-TAFRO project .gitignore
# Single file at repo root covering everything
# ============================================================

# Large RTX-KG2 data files (symlinked on Sockeye, never copied)
imcd_kg_project/data/kgml_data/*.tar.gz
imcd_kg_project/data/kgml_data/bkg_rtxkg2c_v2.7.3/
imcd_kg_project/data/data

# Processed graph (too large to commit, regenerated by Phase 1.2)
imcd_kg_project/data/processed/full_graph.pkl
imcd_kg_project/data/processed/filtered_graph.pkl

# Cloned sub-repositories (have their own git history)
imcd_kg_project/src/KGML-xDTD/
imcd_kg_project/src/KGML-xDTD/.git
imcd_kg_project/src/TxGNN/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
env/
venv/
.env
.venv

# Jupyter
.ipynb_checkpoints

# Logs (generated at runtime on Sockeye)
*.log
imcd_kg_project/logs/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
.mypy_cache/

# Temporary
*.tmp
*.temp

# Sockeye-only investigation scripts (untracked, not needed in repo)
# (these live on Sockeye scratch and are not part of clean codebase)
imcd_kg_project/np
